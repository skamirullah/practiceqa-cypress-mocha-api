{
  "name": "practiceqa-cypress-mocha-api",
  "version": "1.0.0",
  "description": "API automation framework with Cypress and Mocha against the Nova Shop pricing API on PracticeQAAutomation",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@smoke,grepFilterSpecs=true,grepOmitFiltered=true",
    "open": "cypress open",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^9.12.0",
    "cypress": "^16.1.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-cypress": "^4.3.0",
    "globals": "^15.11.0"
  }
}
